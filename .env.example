# Copy to .env and adjust. .env is ignored by git; never commit real secrets.

# PostgreSQL superuser (local development only)
POSTGRES_PASSWORD=admin123

# Shared by the gateway and every service that verifies tokens.
JWT_SECRET=mycima-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Demo administrator seeded by the user service at startup
ADMIN_EMAIL=admin@mycima.com
ADMIN_PASSWORD=admin12345
ADMIN_FULL_NAME=MyCima Admin

LOG_LEVEL=INFO
