# Copy to .env (git-ignored) and fill in the values. Never commit the real key.

# OpenAI-compatible LLM endpoint. Gemini's compatible API by default.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-flash-lite-latest
LLM_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ITERATIONS=5

# Platform
GATEWAY_INTERNAL_URL=http://gateway:8000/api
JWT_SECRET=mycima-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+psycopg2://ai_svc:ai_svc_pass@postgres:5432/ai_assistant_db

# Booking rules
CINEMA_TIMEZONE=Africa/Casablanca
MAX_SEATS_PER_HOLD=8
PROPOSAL_TTL_MINUTES=15

LOG_LEVEL=INFO
